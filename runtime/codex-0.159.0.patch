diff --git a/codex-rs/core/src/compact_jev.rs b/codex-rs/core/src/compact_jev.rs
new file mode 100644
index 0000000..ebf30a3
--- /dev/null
+++ b/codex-rs/core/src/compact_jev.rs
@@ -0,0 +1,195 @@
+//! Optional selective tool-output compaction. The adapter cannot replace conversation items.
+use std::collections::HashSet;
+use std::path::Path;
+use std::process::Stdio;
+use std::sync::Arc;
+use std::time::Duration;
+
+use crate::compact::CompactedHistoryMetadata;
+use crate::session::session::Session;
+use crate::session::turn_context::TurnContext;
+use codex_analytics::CompactionTrigger;
+use codex_history::ResponseItemEnvelope;
+use codex_protocol::error::CodexErr;
+use codex_protocol::error::Result as CodexResult;
+use codex_protocol::items::ContextCompactionItem;
+use codex_protocol::items::TurnItem;
+use codex_protocol::models::FunctionCallOutputBody;
+use codex_protocol::models::ResponseItem;
+use serde::Deserialize;
+use serde_json::json;
+use tokio::io::AsyncReadExt;
+use tokio::io::AsyncWriteExt;
+use tokio::process::Command;
+
+const MAX_REQUEST_BYTES: usize = 64 * 1024 * 1024;
+const MAX_RESPONSE_BYTES: usize = 1024 * 1024;
+const MAX_OUTPUT_BYTES: usize = 40_000;
+const RECENT_ITEMS: usize = 6;
+
+#[derive(Deserialize)]
+struct AdapterResponse {
+    version: u32,
+    #[serde(default)]
+    skip: bool,
+    #[serde(default)]
+    edits: Vec<OutputEdit>,
+}
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct OutputEdit {
+    index: usize,
+    output: String,
+}
+
+/// Validates every edit before changing any item, preserving all IDs and metadata.
+fn apply_edits(items: &mut [ResponseItemEnvelope], response: AdapterResponse) -> bool {
+    if response.version != 1 || response.skip || response.edits.is_empty() {
+        return false;
+    }
+    let mut seen = HashSet::new();
+    for edit in &response.edits {
+        if edit.index == 0
+            || edit.index >= items.len().saturating_sub(RECENT_ITEMS)
+            || !seen.insert(edit.index)
+            || edit.output.len() > MAX_OUTPUT_BYTES
+        {
+            return false;
+        }
+        let (call_id, original, custom) = match &items[edit.index].item {
+            ResponseItem::FunctionCallOutput {
+                call_id: Some(call_id), output, ..
+            } => (call_id, &output.body, false),
+            ResponseItem::CustomToolCallOutput { call_id, output, .. } => {
+                (call_id, &output.body, true)
+            }
+            _ => return false,
+        };
+        let FunctionCallOutputBody::Text(original) = original else {
+            return false;
+        };
+        if edit.output.len() >= original.len()
+            || !items[..edit.index].iter().any(|envelope| match &envelope.item {
+                ResponseItem::FunctionCall { call_id: earlier, .. } => {
+                    !custom && earlier == call_id
+                }
+                ResponseItem::CustomToolCall { call_id: earlier, status, .. } => {
+                    custom && earlier == call_id
+                        && status.as_deref().is_none_or(|status| status == "completed")
+                }
+                _ => false,
+            })
+        {
+            return false;
+        }
+    }
+    for edit in response.edits {
+        match &mut items[edit.index].item {
+            ResponseItem::FunctionCallOutput { output, .. }
+            | ResponseItem::CustomToolCallOutput { output, .. } => {
+                output.body = FunctionCallOutputBody::Text(edit.output);
+            }
+            _ => unreachable!("all edits were validated"),
+        }
+    }
+    true
+}
+
+async fn call_adapter(path: &Path, request: Vec<u8>) -> Option<AdapterResponse> {
+    if request.len() > MAX_REQUEST_BYTES {
+        return None;
+    }
+    let mut child = Command::new(path)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::null())
+        .kill_on_drop(true)
+        .spawn().ok()?;
+    let mut stdin = child.stdin.take()?;
+    let stdout = child.stdout.take()?;
+    let output = async {
+        let write = async move {
+            stdin.write_all(&request).await?;
+            stdin.shutdown().await
+        };
+        let read = async {
+            let mut bytes = Vec::new();
+            stdout.take((MAX_RESPONSE_BYTES + 1) as u64).read_to_end(&mut bytes).await?;
+            Ok::<_, std::io::Error>(bytes)
+        };
+        let (_, bytes) = tokio::try_join!(write, read).ok()?;
+        if bytes.len() > MAX_RESPONSE_BYTES || !child.wait().await.ok()?.success() {
+            return None;
+        }
+        serde_json::from_slice(&bytes).ok()
+    };
+    tokio::time::timeout(Duration::from_secs(90), output).await.ok().flatten()
+}
+
+/// Returns false on unavailable/invalid adapters so the native compactor remains the fallback.
+pub(crate) async fn try_compact(
+    sess: &Arc<Session>,
+    turn: &Arc<TurnContext>,
+    trigger: CompactionTrigger,
+) -> CodexResult<bool> {
+    let Some(path) = std::env::var_os("FAST_JEV_COMPACTION_ADAPTER") else {
+        return Ok(false);
+    };
+    let path = Path::new(&path);
+    if !path.is_absolute() {
+        return Ok(false);
+    }
+    let history = sess.clone_history().await;
+    let mut items = history.annotated_items().to_vec();
+    let raw = items.iter().map(|item| &item.item).collect::<Vec<_>>();
+    let Ok(request) = serde_json::to_vec(&json!({
+        "version": 1, "session_id": sess.thread_id.to_string(),
+        "turn_id": turn.sub_id, "cwd": turn.cwd,
+        "model": turn.model_info().slug,
+        "trigger": match trigger { CompactionTrigger::Manual => "manual", CompactionTrigger::Auto => "auto" },
+        "items": raw,
+    })) else { return Ok(false) };
+    let cancellation = {
+        let active = sess.active_turn.lock().await;
+        active.as_ref().and_then(|active| active.task.as_ref())
+            .map(|task| task.cancellation_token.child_token())
+            .unwrap_or_default()
+    };
+    let response = tokio::select! {
+        response = call_adapter(path, request) => response,
+        _ = cancellation.cancelled() => return Err(CodexErr::TurnAborted),
+    };
+    let Some(response) = response else { return Ok(false) };
+    if cancellation.is_cancelled() {
+        return Err(CodexErr::TurnAborted);
+    }
+    let before_bytes = serde_json::to_vec(&raw).map(|bytes| bytes.len()).unwrap_or_default();
+    if !apply_edits(&mut items, response) {
+        return Ok(false);
+    }
+    let after_bytes = serde_json::to_vec(&items.iter().map(|item| &item.item).collect::<Vec<_>>())
+        .map(|bytes| bytes.len()).unwrap_or_default();
+    // Steering or another accepted update during the subprocess invalidates its indices.
+    let current = sess.clone_history().await;
+    if current.annotated_items() != history.annotated_items() {
+        return Ok(false);
+    }
+    let compaction_item = TurnItem::ContextCompaction(ContextCompactionItem::new());
+    sess.emit_turn_item_started(turn, &compaction_item).await;
+    let reference = sess.reference_context_item().await;
+    let (window_number, window_ids) = sess.advance_auto_compact_window().await;
+    sess.replace_compacted_history(items, reference, None, CompactedHistoryMetadata {
+        message: String::new(), preserve_world_state: true, window_number, window_ids,
+        compaction_response_id: None, compaction_model_hash: turn.model_info().comp_hash.clone(),
+        reviewer_compaction_hash: None,
+    }).await;
+    sess.recompute_token_usage(turn).await;
+    sess.emit_turn_item_completed(turn, compaction_item).await;
+    tracing::info!(before_bytes, after_bytes, "Jev selective compaction installed");
+    Ok(true)
+}
+
+#[cfg(test)]
+#[path = "compact_jev_tests.rs"]
+mod tests;
