+use super::*;
+use pretty_assertions::assert_eq;
+
+fn item(value: serde_json::Value) -> ResponseItemEnvelope {
+    ResponseItemEnvelope::new(serde_json::from_value(value).unwrap())
+}
+
+fn history() -> Vec<ResponseItemEnvelope> {
+    let mut items = vec![
+        item(json!({"type":"message","role":"user","content":[{"type":"input_text","text":"preserve user"}]})),
+        item(json!({"type":"function_call","call_id":"old","name":"shell","arguments":"{}"})),
+        item(json!({"type":"function_call_output","call_id":"old","output":"original tool output"})),
+    ];
+    items.extend((0..6).map(|_| item(json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"preserve assistant"}]}))));
+    items
+}
+
+fn response(edits: serde_json::Value) -> AdapterResponse {
+    serde_json::from_value(json!({"version":1,"edits":edits})).unwrap()
+}
+
+#[test]
+fn edits_preserve_calls_prose_and_metadata() {
+    let mut items = history();
+    items[2].metadata = Some(codex_history::CodexHarnessMetadata {
+        compaction_output: true,
+        ..Default::default()
+    });
+    let original = items.clone();
+    assert!(apply_edits(&mut items, response(json!([{"index":2,"output":"pruned"}]))));
+    let mut expected = original;
+    if let ResponseItem::FunctionCallOutput { output, .. } = &mut expected[2].item {
+        output.body = FunctionCallOutputBody::Text("pruned".to_string());
+    }
+    assert_eq!(items, expected);
+}
+
+#[test]
+fn invalid_edits_are_atomic() {
+    for edits in [
+        json!([{"index":2,"output":"short"},{"index":1,"output":"invalid"}]),
+        json!([{"index":2,"output":"short"},{"index":2,"output":"other"}]),
+        json!([{"index":999,"output":"invalid"}]),
+        json!([{"index":3,"output":"recent"}]),
+        json!([{"index":2,"output":"replacement longer than the original tool output"}]),
+    ] {
+        let mut items = history();
+        let original = items.clone();
+        assert!(!apply_edits(&mut items, response(edits)));
+        assert_eq!(items, original);
+    }
+}
+
+#[test]
+fn orphan_and_structured_outputs_are_rejected() {
+    for replacement in [
+        json!({"type":"function_call_output","call_id":"orphan","output":"original tool output"}),
+        json!({"type":"function_call_output","call_id":"old","output":[{"type":"input_text","text":"structured"}]}),
+    ] {
+        let mut items = history();
+        items[2] = item(replacement);
+        assert!(!apply_edits(&mut items, response(json!([{"index":2,"output":"short"}]))));
+    }
+}
+
+#[test]
+fn custom_outputs_keep_success_and_require_completed_calls() {
+    let mut items = history();
+    items[1] = item(json!({"type":"custom_tool_call","call_id":"old","name":"apply_patch","input":"patch","status":"completed"}));
+    items[2] = item(json!({"type":"custom_tool_call_output","call_id":"old","output":"original custom output"}));
+    if let ResponseItem::CustomToolCallOutput { output, .. } = &mut items[2].item {
+        output.success = Some(true);
+    }
+    let mut expected = items.clone();
+    if let ResponseItem::CustomToolCallOutput { output, .. } = &mut expected[2].item {
+        output.body = FunctionCallOutputBody::Text("short".to_string());
+    }
+    assert!(apply_edits(&mut items, response(json!([{"index":2,"output":"short"}]))));
+    assert_eq!(items, expected);
+    if let ResponseItem::CustomToolCall { status, .. } = &mut items[1].item {
+        *status = Some("in_progress".to_string());
+    }
+    assert!(!apply_edits(&mut items, response(json!([{"index":2,"output":"x"}]))));
+}
