+#!/usr/bin/env python3
+"""Native-compaction fixture: selected by the test runner, never changes process environment."""
+import json
+import sys
+request = json.load(sys.stdin)
+items = request["items"]
+if any("JEV_FALLBACK" in json.dumps(item) for item in items):
+    print(json.dumps({"version": 1, "skip": True}))
+else:
+    edits = [
+        {"index": index, "output": "JEV_PRUNED"}
+        for index, item in enumerate(items[:-6])
+        if item.get("type") == "function_call_output"
+        and isinstance(item.get("output"), str)
+        and len(item["output"]) > 10
+    ]
+    print(json.dumps({"version": 1, "edits": edits}))
