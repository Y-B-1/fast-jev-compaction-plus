+//! Focused native Jev compaction behavior and production edit-validation tests.
+#![allow(clippy::expect_used)]
+
+use anyhow::Result;
+use codex_login::CodexAuth;
+use codex_protocol::models::ResponseItem;
+use codex_protocol::protocol::EventMsg;
+use codex_protocol::protocol::Op;
+use core_test_support::responses;
+use core_test_support::responses::mount_sse_once;
+use core_test_support::responses::sse;
+use core_test_support::skip_if_no_network;
+use core_test_support::test_codex::TestCodexHarness;
+use core_test_support::test_codex::test_codex;
+use core_test_support::wait_for_event_with_timeout;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::time::Duration;
+
+// Compile the production validator itself, including its four behavior tests.
+#[path = "../src/compact_jev/edits.rs"]
+mod edits;
+
+async fn wait_for_turn_complete(codex: &codex_core::CodexThread) {
+    wait_for_event_with_timeout(
+        codex,
+        |event| matches!(event, EventMsg::TurnComplete(_)),
+        Duration::from_secs(30),
+    )
+    .await;
+}
+
+// Run these fixture-backed integration tests with FAST_JEV_COMPACTION_ADAPTER set to
+// the absolute executable tests/fixtures/jev_compaction_adapter.py path.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn jev_native_compaction_preserves_history_without_model_request() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    if std::env::var_os("FAST_JEV_COMPACTION_ADAPTER").is_none() {
+        return Ok(());
+    }
+    let harness = TestCodexHarness::with_builder(
+        test_codex().with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing()),
+    )
+    .await?;
+    let codex = harness.test().codex.clone();
+    let mut history = vec![
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"JEV_USER_PROSE"}]}),
+        json!({"type":"function_call","call_id":"jev-old","name":"exec_command","arguments":"{}"}),
+        json!({"type":"function_call_output","call_id":"jev-old","output":"old large tool output that Jev can shorten"}),
+    ];
+    history.extend((0..6).map(|_| json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"JEV_ASSISTANT_PROSE"}]})));
+    codex
+        .inject_response_items(
+            history
+                .into_iter()
+                .map(serde_json::from_value)
+                .collect::<serde_json::Result<Vec<ResponseItem>>>()?,
+        )
+        .await?;
+    let model = mount_sse_once(harness.server(), responses::sse_completed("after-jev")).await;
+    codex.submit(Op::Compact).await?;
+    wait_for_turn_complete(&codex).await;
+    assert!(
+        model.requests().is_empty(),
+        "selective compaction must not call the model"
+    );
+    harness.test().submit_turn("continue after Jev").await?;
+    let request = model.single_request();
+    assert!(request.body_contains_text("JEV_USER_PROSE"));
+    assert!(request.body_contains_text("JEV_ASSISTANT_PROSE"));
+    assert_eq!(
+        request.function_call_output_text("jev-old"),
+        Some("JEV_PRUNED".to_string())
+    );
+    assert_eq!(request.inputs_of_type("function_call").len(), 1);
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn jev_native_compaction_skip_uses_builtin_fallback() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    if std::env::var_os("FAST_JEV_COMPACTION_ADAPTER").is_none() {
+        return Ok(());
+    }
+    let harness = TestCodexHarness::with_builder(
+        test_codex().with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing()),
+    )
+    .await?;
+    let codex = harness.test().codex.clone();
+    codex.inject_response_items(vec![serde_json::from_value(json!({"type":"message","role":"user","content":[{"type":"input_text","text":"JEV_FALLBACK"}]}))?]).await?;
+    let model = mount_sse_once(harness.server(), sse(vec![
+        json!({"type":"response.output_item.done","item":{"type":"compaction","encrypted_content":"NATIVE_FALLBACK"}}),
+        responses::ev_completed("jev-fallback"),
+    ])).await;
+    codex.submit(Op::Compact).await?;
+    wait_for_turn_complete(&codex).await;
+    assert_eq!(
+        model
+            .single_request()
+            .inputs_of_type("compaction_trigger")
+            .len(),
+        1
+    );
+    Ok(())
+}
