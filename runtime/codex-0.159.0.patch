+// Run these fixture-backed integration tests with FAST_JEV_COMPACTION_ADAPTER set to
+// the absolute executable tests/fixtures/jev_compaction_adapter.py path.
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn jev_native_compaction_preserves_history_without_model_request() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    if std::env::var_os("FAST_JEV_COMPACTION_ADAPTER").is_none() {
+        return Ok(());
+    }
+    let harness = TestCodexHarness::with_builder(
+        test_codex().with_auth(CodexAuth::create_dummy_chatgpt_auth_for_testing()),
+    ).await?;
+    let codex = harness.test().codex.clone();
+    let mut history = vec![
+        json!({"type":"message","role":"user","content":[{"type":"input_text","text":"JEV_USER_PROSE"}]}),
+        json!({"type":"function_call","call_id":"jev-old","name":"exec_command","arguments":"{}"}),
+        json!({"type":"function_call_output","call_id":"jev-old","output":"old large tool output that Jev can shorten"}),
+    ];
+    history.extend((0..6).map(|_| json!({"type":"message","role":"assistant","content":[{"type":"output_text","text":"JEV_ASSISTANT_PROSE"}]})));
+    codex.inject_response_items(history.into_iter().map(serde_json::from_value).collect::<serde_json::Result<Vec<ResponseItem>>>()?).await?;
+    let model = mount_sse_once(harness.server(), responses::sse_completed("after-jev")).await;
+    codex.submit(Op::Compact).await?;
+    wait_for_turn_complete(&codex).await;
+    assert!(model.requests().is_empty(), "selective compaction must not call the model");
+    harness.test().submit_turn("continue after Jev").await?;
+    let request = model.single_request();
+    assert!(request.body_contains_text("JEV_USER_PROSE"));
+    assert!(request.body_contains_text("JEV_ASSISTANT_PROSE"));
+    assert_eq!(request.function_call_output_text("jev-old"), Some("JEV_PRUNED".to_string()));
+    assert_eq!(request.inputs_of_type("function_call").len(), 1);
+    Ok(())
+}
